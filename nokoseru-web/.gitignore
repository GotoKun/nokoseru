# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sqlite db
/prisma/dev.db
/prisma/dev.db-journal

# 収録された動画・写真・エクスポートzip（実データを含むためコミットしない）
/storage/

# `prisma init` が自動導入するAIエージェント向けskillsドキュメント（アプリ本体とは無関係）
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
